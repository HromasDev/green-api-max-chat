{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "vitest"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": ["dist", "src/routeTree.gen.ts"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "eqeqeq": ["error", "always"],
    "no-console": ["warn", { "allow": ["warn", "error"] }]
  },
  "overrides": [
    {
      "files": ["src/routes/**"],
      "rules": { "react/only-export-components": "off" }
    },
    {
      "files": ["src/shared/ui/**"],
      "rules": { "react/only-export-components": "off" }
    },
    {
      "files": ["src/pages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["#/app/**"],
                "message": "FSD: pages не могут импортировать app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/widgets/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["#/app/**", "#/pages/**"],
                "message": "FSD: widgets видят только features, entities, shared."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["#/app/**", "#/pages/**", "#/widgets/**"],
                "message": "FSD: features видят только entities и shared."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/entities/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "#/app/**",
                  "#/pages/**",
                  "#/widgets/**",
                  "#/features/**"
                ],
                "message": "FSD: entities видят только shared."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "#/app/**",
                  "#/pages/**",
                  "#/widgets/**",
                  "#/features/**",
                  "#/entities/**"
                ],
                "message": "FSD: shared не знает про верхние слои."
              }
            ]
          }
        ]
      }
    }
  ]
}
